
# Server
PORT=9000
NODE_ENV=development

# Database
MONGO_DB_URI=mongodb://localhost:27017/PeerHiringDB

# Frontend URL
CLIENT_URL=http://localhost:5173

# JWT Authentication
ACCESS_TOKEN_SECRET=replace_with_your_access_token_secret
REFRESH_TOKEN_SECRET=replace_with_your_refresh_token_secret
ACCESS_TOKEN_EXPIRY=30d
REFRESH_TOKEN_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# SMTP / Brevo
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SENDER_EMAIL=your_sender_email

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin account
ADMIN_EMAIL=your_admin_email
ADMIN_NAME=your_admin_name
ADMIN_PASSWORD=replace_with_a_secure_admin_password
